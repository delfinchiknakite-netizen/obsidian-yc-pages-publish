# YC-зеркало провайдеров (HashiCorp registry заблокирован из РФ).
# Использование:  export TF_CLI_CONFIG_FILE="$PWD/.terraformrc"  перед terraform init
provider_installation {
  network_mirror {
    url     = "https://terraform-mirror.yandexcloud.net/"
    include = ["registry.terraform.io/*/*"]
  }
  direct {
    exclude = ["registry.terraform.io/*/*"]
  }
}
